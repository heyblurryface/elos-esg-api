{
  "info": {
    "name": "Kaizen API - Diagnostico ESG (ASP.NET Core 8)",
    "description": "Colecao de testes da Kaizen API (FIAP - ESG #4 Governanca e Compliance).\n\nCOMO USAR:\n1. Suba a API (docker compose up --build) - base http://localhost:8080.\n2. Rode 'Auth > Login' primeiro: o JWT e salvo automaticamente em {{token}} e aplicado como Bearer nas demais chamadas.\n3. Os IDs usados nos exemplos existem no seed (empresas 101-105, consultores 201-203, avaliacoes 1-3, perguntas 1-32).\n\nVariaveis: baseUrl, token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health (DevOps)",
      "item": [
        {
          "name": "Health check (ambiente e versão)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (salva o token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@kaizen.com.br\",\n  \"senha\": \"kaizen123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Autentica e salva o JWT em {{token}}. Rode este primeiro.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Salva o JWT retornado na variavel de colecao {{token}}",
                  "pm.test(\"Status code e 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "if (data && data.token) {",
                  "    pm.collectionVariables.set(\"token\", data.token);",
                  "    console.log(\"Token salvo com sucesso (\" + data.token.substring(0, 24) + \"...)\");",
                  "} else {",
                  "    console.warn(\"Resposta sem campo 'token' - verifique o login.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Consultor Teste\",\n  \"email\": \"novo.consultor@kaizen.com.br\",\n  \"senha\": \"senha123\",\n  \"foto\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria um novo consultor e ja devolve um JWT.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
