# Referência do .env que o pipeline gera na VM para STAGING.
# Os valores sensíveis vêm dos secrets do environment "staging" no GitHub.
COMPOSE_PROJECT_NAME=elos-staging
ASPNETCORE_ENVIRONMENT=Staging
API_PORT=8081
API_IMAGE=ghcr.io/<usuario>/<repositorio>:sha-<commit>
APP_VERSION=<commit>
ORACLE_PASSWORD=<secret ORACLE_PASSWORD>
APP_DB_USER=kaizen
APP_DB_PASSWORD=<secret APP_DB_PASSWORD>
JWT_SECRET=<secret JWT_SECRET>
JWT_EXPIRES_MINUTES=120
