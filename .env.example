# =============================================================================
# Variáveis de ambiente - copie para ".env" e ajuste (o .env não vai pro Git)
#   cp .env.example .env
# =============================================================================

# Ambiente do ASP.NET Core: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Porta publicada da API no host
API_PORT=8080

# Imagem da API (local: gerada pelo build; staging/prod: imagem do GHCR)
API_IMAGE=elos-esg-api:local
APP_VERSION=local

# Oracle (senha do SYS/SYSTEM e usuário da aplicação)
ORACLE_PASSWORD=TroqueEstaSenha123
APP_DB_USER=kaizen
APP_DB_PASSWORD=TroqueEstaSenha456

# JWT (mínimo 32 caracteres)
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
JWT_EXPIRES_MINUTES=120
